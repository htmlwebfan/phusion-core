<h2>Request Password Reset</h2>

<?php if (isset($success)): ?>
    <p style="color: green;"><?php echo $e($success); ?></p>
<?php elseif (isset($errors)): ?>
    <ul style="color: red;">
        <?php foreach ($errors as $error): ?>
            <li><?php echo $e($error); ?></li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>

<?php if (!isset($success)): ?>
    <form method="POST" action="<?php echo $e($base_url . '/password/request'); ?>">
        <input type="hidden" name="csrf_token" value="<?php echo $e($csrf_token); ?>">
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="<?php echo $e($email ?? ''); ?>" required>
        <div class="g-recaptcha" data-sitekey="<?php echo $e($recaptcha_site_key); ?>"></div>
        <button type="submit">Send Reset Link</button>
    </form>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
<?php endif; ?>

<p>Back to <a href="<?php echo $e($base_url . '/auth/login'); ?>">Login</a></p>