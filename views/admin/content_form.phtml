<h2><?php echo isset($item) ? 'Edit' : 'Add'; ?> Content</h2>

<?php if (isset($errors)): ?>
    <ul style="color: red;">
        <?php foreach ($errors as $error): ?>
            <li><?php echo $e($error); ?></li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>

<form method="POST" action="<?php echo $e($base_url . '/admin/content/' . (isset($item) ? 'edit/' . $item['id'] : 'add')); ?>">
    <input type="hidden" name="csrf_token" value="<?php echo $e($csrf_token); ?>">
    <label for="title">Title:</label>
    <input type="text" id="title" name="title" value="<?php echo $e($item['title'] ?? ''); ?>" required>
    <label for="slug">Slug:</label>
    <input type="text" id="slug" name="slug" value="<?php echo $e($item['slug'] ?? ''); ?>" required>
    <label for="content">Content (Supports Markdown, e.g., # Heading, **bold**):</label>
    <textarea id="content" name="content" required><?php echo $e($item['content'] ?? ''); ?></textarea>
    <label for="type">Type:</label>
    <select id="type" name="type">
        <option value="page" <?php echo ($item['type'] ?? 'post') === 'page' ? 'selected' : ''; ?>>Page</option>
        <option value="post" <?php echo ($item['type'] ?? 'post') === 'post' ? 'selected' : ''; ?>>Post</option>
    </select>
    <label for="meta_title">Meta Title:</label>
    <input type="text" id="meta_title" name="meta_title" value="<?php echo $e($item['meta_title'] ?? ''); ?>">
    <label for="meta_description">Meta Description:</label>
    <input type="text" id="meta_description" name="meta_description" value="<?php echo $e($item['meta_description'] ?? ''); ?>">
    <label for="meta_image">Meta Image URL:</label>
    <input type="text" id="meta_image" name="meta_image" value="<?php echo $e($item['meta_image'] ?? ''); ?>">
    <label for="published">Published:</label>
    <input type="checkbox" id="published" name="published" value="1" <?php echo ($item['published'] ?? 0) ? 'checked' : ''; ?>>
    <button type="submit">Save</button>
</form>
<p><a href="<?php echo $e($base_url . '/admin/content'); ?>">Back to List</a></p>